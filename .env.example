# ===================================================================
# VeriLoom AI — Environment Variables & Model Provider Configuration
# ===================================================================
# Copy this file to .env and insert your API keys:
#   cp .env.example .env

# Active Provider Override (Options: gemini | claude | openai | ollama)
# If left blank, VeriLoom automatically detects whichever API key is set below.
VERILOOM_LLM_PROVIDER=gemini

# --- Google Gemini API (Recommended) ---
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic Claude API ---
# Get an API key from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- OpenAI API ---
# Get an API key from OpenAI Platform: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local Ollama (Free, Offline, & Private) ---
# Download Ollama from https://ollama.com and run: ollama run deepseek-coder
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-coder

# --- Server Configuration ---
HOST=127.0.0.1
PORT=8000
